{
  "name": "@dudousxd/nestjs-codegen-zod",
  "version": "0.5.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/nestjs-codegen.git",
    "directory": "packages/zod"
  },
  "homepage": "https://davidecarvalho.github.io/aviary/docs/codegen",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/nestjs-codegen/issues"
  },
  "keywords": ["nestjs", "codegen", "zod"],
  "description": "Zod validation adapter for @dudousxd/nestjs-codegen — renders the schema IR to zod source.",
  "license": "MIT",
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@dudousxd/nestjs-codegen": ">=0.3.0 <1"
  },
  "devDependencies": {
    "@dudousxd/nestjs-codegen": "workspace:*",
    "@types/node": "24.13.5",
    "ts-morph": "28.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
